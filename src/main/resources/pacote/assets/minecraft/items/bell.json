{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "sinos:sino",
        "model": {
          "type": "minecraft:model",
          "model": "sinos:item/sino"
        }
      },
      {
        "when": "sinos:badalo",
        "model": {
          "type": "minecraft:model",
          "model": "sinos:item/badalo"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/bell"
    }
  }
}
